# FRED 무료 API 키 (https://fred.stlouisfed.org/docs/api/api_key.html) — 경제지표 발표일정 자동수집
FRED_API_KEY=
# 서브디렉토리 게시 시 경로(앞뒤 슬래시 없이). 서브도메인(market.sielain.com) 방식이면 비움
MM_BASE_PATH=
MM_PORT=8502
# 1 = 합성 데이터(개발/데모). 운영에서는 0
MM_OFFLINE=0
# Alpha Vantage 무료 키 (https://www.alphavantage.co/support/#api-key) — Yahoo 실패 시 ETF 폴백 + 뉴스 감성 피드
ALPHAVANTAGE_API_KEY=
# Claude API 키 — LLM 일일 브리핑/주간 다이제스트. 없으면 템플릿 브리핑으로 동작
ANTHROPIC_API_KEY=
# 브리핑 모델 (기본 claude-opus-5-5)
MM_LLM_MODEL=claude-opus-5-5
